from __future__ import annotations

import asyncio
import httpx

from ..models import PhoneReport, PluginResult
from .base import Plugin

HIBP_URL = "https://haveibeenpwned.com/api/v3/breachedaccount/{account}"


class HIBPPlugin(Plugin):
    """Проверка утечек через HaveIBeenPwned (требует API key)."""

    name = "hibp"
    requires_key = "HIBP_API_KEY"

    async def run(self, report: PhoneReport, client: httpx.AsyncClient) -> PluginResult:
        if not report.e164:
            return PluginResult(name=self.name, status="skipped", error="no e164")

        headers = {
            "hibp-api-key": self.env["HIBP_API_KEY"],
            "user-agent": "phone-osint",
        }
        url = HIBP_URL.format(account=report.e164)

        for attempt in range(3):
            try:
                r = await client.get(url, headers=headers, timeout=15)
                if r.status_code == 200:
                    breaches = [b["Name"] for b in r.json()]
                    return PluginResult(
                        name=self.name,
                        status="ok",
                        data={"breaches": breaches, "count": len(breaches)},
                    )
                if r.status_code == 404:
                    return PluginResult(
                        name=self.name,
                        status="ok",
                        data={"breaches": [], "count": 0},
                    )
                if r.status_code == 429:
                    await asyncio.sleep(2 ** attempt)
                    continue
                return PluginResult(
                    name=self.name, status="error",
                    error=f"HTTP {r.status_code}",
                )
            except Exception as e:
                if attempt == 2:
                    return PluginResult(name=self.name, status="error", error=str(e))
                await asyncio.sleep(2 ** attempt)

        return PluginResult(name=self.name, status="error", error="retries exhausted")
